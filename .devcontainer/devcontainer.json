{
   "name": "PostgreSQL dev container",
   "build": {
        "dockerfile": "Dockerfile",
        "args": { "PGVERSION": "18.6" }
    },
    "runArgs": [ "--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined" ],
    "customizations": {
        "vscode": {
          "extensions": [
            "ms-vscode.cpptools",
            "ms-vscode.cmake-tools",
            "ms-azuretools.vscode-docker",
            "streetsidesoftware.code-spell-checker",
            "ms-vscode.cpptools-extension-pack",
            "ms-vscode.makefile-tools",
            "yzhang.markdown-all-in-one",
            "ash-blade.postgresql-hacker-helper"
         ]
        }
     },
    "remoteUser": "vscode",
    "postStartCommand": "pg_ctl start -D /home/vscode/pgdata -l /home/vscode/postgresql.log",
    "postAttachCommand": "if [ ! -f /home/vscode/.pg-src-added ]; then code --add /usr/local/src/postgresql && touch /home/vscode/.pg-src-added; fi",
    "forwardPorts": [5432]
}
